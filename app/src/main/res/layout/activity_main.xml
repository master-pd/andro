<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <!-- App Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MAR-PD ☠️ v1.0"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:typeface="monospace"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:textStyle="bold" />

    <!-- Terminal Output -->
    <ScrollView
        android:id="@+id/terminalScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111"
        android:padding="10dp">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:typeface="monospace"
            android:text="[*] MAR-PD System Monitor Initialized...\n[+] Loading real-time data...\n" />

    </ScrollView>

    <!-- Real-time Stats Box -->
    <TextView
        android:id="@+id/realTimeStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#1A1A1A"
        android:padding="10dp"
        android:textColor="#00FFFF"
        android:textSize="11sp"
        android:typeface="monospace"
        android:text="Loading system data..." />

    <!-- Command Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:typeface="monospace"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="5dp" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#222222"
            android:textColor="#FFFFFF"
            android:hint="Type command..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:singleLine="true"
            android:typeface="monospace" />

        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⟳"
            android:textColor="#00FF00"
            android:background="#333333"
            android:layout_marginLeft="5dp" />

    </LinearLayout>

    <!-- Status Bar -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="[READY] | Mode: SAFE | User: ${user}"
        android:textColor="#888888"
        android:textSize="10sp"
        android:typeface="monospace"
        android:gravity="center" />

</LinearLayout>
